{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-card-icon",
	"version": "0.1.0",
	"title": "Card - Icon",
	"category": "wbg-cards",
	"icon": "menu",
	"description": "A card with an icon and various content underneath.",
	"keywords": ["card"],
	"example": {
		"viewportWidth": 350,
		"attributes": {
			"icon": "building"
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 3,
					"textColor": "green",
					"style": {
						"typography": { "fontStyle": "italic", "textAlign": "center" }
					},
					"content": "Headline goes here."
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris bibendum massa sed eros vestibulum.",
					"style": {
						"typography": { "textAlign": "center" }
					}
				}
			},
			{
				"name": "core/buttons",
				"attributes": {
					"layout": {
						"type": "flex",
						"justifyContent": "center"
					}
				},
				"innerBlocks": [
					{
						"name": "core/button",
						"attributes": {
							"text": "Get involved"
						}
					}
				]
			}
		]
	},
	"attributes": {
		"icon": {
			"type": "string",
			"enum": [
				"none",
				"bonsai",
				"building",
				"butterfly",
				"education",
				"flowers",
				"group",
				"heron",
				"lilypads",
				"planting"
			],
			"default": "building"
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"blockGap": true,
			"__experimentalDefaultControls": {
				"blockGap": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
