{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-card-simple",
	"version": "0.1.0",
	"title": "Card - Simple",
	"category": "wbg-cards",
	"icon": "menu",
	"description": "A simple card with inner blocks.",
	"keywords": ["card"],
	"example": {
		"viewportWidth": 450,
		"attributes": {
			"heading": "Walking Paths",
			"isPreview": true,
			"textColor": "green",
			"style": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|32",
						"bottom": "var:preset|spacing|32",
						"left": "var:preset|spacing|32",
						"right": "var:preset|spacing|32"
					}
				}
			}
		},
		"innerBlocks": [
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "To avoid potentially damaging the plants, please refrain from stepping or walking in the beds. We also ask that you don’t pick, cut, or remove flowers, plants, or seeds. Please do not climb trees or structures in the Gardens.",
					"textColor": "dark-green"
				}
			},
			{
				"name": "core/buttons",
				"innerBlocks": [
					{
						"name": "core/button",
						"attributes": {
							"text": "Button Here"
						}
					}
				]
			}
		]
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"isPreview": {
			"type": "boolean",
			"default": false
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|24",
						"bottom": "var:preset|spacing|24",
						"left": "var:preset|spacing|24",
						"right": "var:preset|spacing|24"
					}
				}
			}
		},
		"backgroundColor": {
			"type": "string",
			"default": "cream"
		},
		"textColor": {
			"type": "string",
			"default": "dark-green"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"padding": ["top", "bottom", "left", "right"],
			"blockGap": true,
			"__experimentalDefaultControls": {
				"padding": true,
				"blockGap": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		},
		"layout": {
			"allowEditing": false
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
