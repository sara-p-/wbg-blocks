{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-content-overlap",
	"version": "0.1.0",
	"title": "Content Overlap",
	"category": "wbg-content",
	"icon": "align-pull-right",
	"description": "Content next to an image pinned to the side of the screen that overlaps the blocks above or below.",
	"keywords": ["content", "section", "columns", "image", "overlap"],
	"example": {
		"viewportWidth": 1400,
		"attributes": {
			"showSubheading": false,
			"heading": "Why Your Support Matters",
			"headingSize": "large",
			"imagePosition": "top-right",
			"imageOverlap": 0,
			"backgroundColor": "cream",
			"style": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				},
				"background": {
					"backgroundImage": {
						"url": "/wp-content/uploads/2026/11/content-overlap-example-2.webp",
						"source": "file",
						"title": "content-overlap-example-2"
					},
					"backgroundSize": "contain",
					"backgroundPosition": "50% 50%",
					"backgroundRepeat": "no-repeat"
				}
			}
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 5,
					"levelOptions": [4, 5, 6],
					"content": "The Gardens are for everyone, and it takes everyone working together to keep them running smoothly. Every peaceful afternoon in the shade, every class that brings you closer to your goals, and every event that creates community requires support from volunteers, donors, and sponsors who believe that our living legacy is worth investing in."
				}
			},
			{
				"name": "core/buttons",
				"innerBlocks": [
					{
						"name": "core/button",
						"attributes": {
							"text": "Learn More"
						}
					}
				]
			}
		]
	},
	"attributes": {
		"showSubheading": {
			"type": "boolean",
			"default": false
		},
		"subheading": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"headingSize": {
			"type": "string",
			"enum": ["standard", "large"],
			"default": "standard"
		},
		"contentWidth": {
			"type": "string",
			"enum": ["standard", "wide"],
			"default": "standard"
		},
		"contentColumnWidth": {
			"type": "number",
			"default": 50
		},
		"imagePosition": {
			"type": "string",
			"enum": ["top-left", "bottom-left", "bottom-right", "top-right"],
			"default": "top-right"
		},
		"videoId": {
			"type": "number"
		},
		"videoUrl": {
			"type": "string",
			"default": ""
		},
		"imageWidth": {
			"type": "number",
			"default": 450
		},
		"imageHeight": {
			"type": "number",
			"default": 500
		},
		"imageOverlap": {
			"type": "number",
			"default": 150
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": {
			"background": true,
			"text": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"backgroundImage": true
			}
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
