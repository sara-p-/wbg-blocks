{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-content-overlay-section",
	"version": "0.1.0",
	"title": "Overlay Image Section",
	"category": "wbg-content",
	"icon": "menu",
	"description": "An section that takes one of the overlay blocks.",
	"keywords": ["section", "headline", "heading"],
	"example": {
		"viewportWidth": 1440,
		"attributes": {
			"contentWidth": "wide"
		},
		"innerBlocks": [
			{
				"name": "wbg-blocks/wbg-content-overlay-2-col",
				"attributes": {
					"showSubHeading": true,
					"heading": "A Living Legacy",
					"overhang": 100,
					"contentPosition": "content-right",
					"style": {
						"background": {
							"backgroundImage": {
								"url": "/wp-content/uploads/2026/11/overlay-2-col-example.webp",
								"source": "file",
								"title": "2-col-example"
							},
							"backgroundSize": "contain",
							"backgroundPosition": "50% 50%",
							"backgroundRepeat": "no-repeat"
						},
						"spacing": {
							"padding": {
								"top": "var:preset|spacing|60",
								"bottom": "var:preset|spacing|60"
							}
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "There's so much more to come. What's ahead includes a bonsai garden, a two-acre Japanese garden designed in Kyoto, a children's garden, and eventually a conservatory. We'd be glad to have you along for the rest of it.",
							"textColor": "cream"
						}
					},
					{
						"name": "core/buttons",
						"innerBlocks": [
							{
								"name": "core/button",
								"attributes": {
									"text": "Stay in Touch"
								}
							}
						]
					}
				]
			}
		]
	},
	"attributes": {
		"contentWidth": {
			"type": "string",
			"enum": ["normal", "wide"],
			"default": "wide"
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		},
		"backgroundColor": {
			"type": "string",
			"default": "cream"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
