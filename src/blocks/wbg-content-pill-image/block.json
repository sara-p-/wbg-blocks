{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-content-pill-image",
	"version": "0.3.0",
	"title": "Pill Image",
	"category": "wbg-content",
	"icon": "format-image",
	"description": "A section with a pill-shaped image.",
	"keywords": ["image", "pill"],
	"example": {
		"viewportWidth": 1400,
		"attributes": {
			"style": {
				"background": {
					"backgroundImage": {
						"url": "/wp-content/uploads/2026/10/2-col-example.webp",
						"source": "file",
						"title": "2-col-example"
					},
					"backgroundSize": "cover",
					"backgroundPosition": "50% 50%",
					"backgroundRepeat": "no-repeat"
				}
			}
		}
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		},
		"backgroundColor": {
			"type": "string",
			"default": "cream"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": false,
			"__experimentalDefaultControls": {
				"background": true
			}
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"backgroundImage": true
			}
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
