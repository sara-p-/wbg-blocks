{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-hero-static-parent",
	"version": "0.1.0",
	"title": "Hero - Static",
	"category": "wbg-heros",
	"icon": "menu",
	"description": "A hero with a pill image and content.",
	"keywords": ["section", "hero", "background", "1-column"],
	"example": {
		"viewportWidth": 1444,

		"attributes": {
			"style": {
				"type": "object",
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|160",
						"bottom": "var:preset|spacing|160"
					}
				}
			}
		},

		"innerBlocks": [
			{
				"name": "wbg-blocks/wbg-hero-static-child",
				"attributes": {
					"heading": "Learn at the Gardens",
					"style": {
						"background": {
							"backgroundImage": {
								"url": "/wp-content/uploads/2026/10/2-col-example.webp",
								"source": "file",
								"title": "2-col-example"
							},
							"backgroundSize": "cover",
							"backgroundPosition": "50% 50%",
							"backgroundRepeat": "no-repeat"
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Whether you're here for a class, a camp, or a Saturday morning with the kids, there's something to explore on every path. Come see what captures your curiosity."
						}
					},
					{
						"name": "core/buttons",
						"innerBlocks": [
							{
								"name": "core/button",
								"attributes": {
									"text": "Explore Programs"
								}
							},
							{
								"name": "core/button",
								"attributes": {
									"text": "Browse Resources",
									"className": "is-style-outline-light"
								}
							}
						]
					}
				]
			}
		]
	},
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|160",
						"bottom": "var:preset|spacing|160"
					}
				}
			}
		},
		"backgroundColor": {
			"type": "string",
			"default": "green"
		}
	},
	"supports": {
		"html": false,
		"background": {
			"backgroundImage": true,
			"backgroundSize": true,
			"__experimentalDefaultControls": {
				"backgroundImage": true
			}
		},
		"color": {
			"background": true,
			"text": false
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
