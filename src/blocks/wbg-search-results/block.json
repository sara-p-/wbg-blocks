{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-search-results",
	"version": "0.1.0",
	"title": "WBG Search Results",
	"category": "wbg-search",
	"icon": "search",
	"description": "A full-width section that shows the site's search results (native WP search or Relevanssi) in a grid, grouped by post type.",
	"keywords": ["search", "results", "relevanssi", "query", "grid"],
	"attributes": {
		"layoutWidth": {
			"type": "string",
			"enum": ["standard", "wide"],
			"default": "standard"
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"gradients": false,
			"link": false,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true,
			"__experimentalDefaultControls": {
				"backgroundImage": true
			}
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
