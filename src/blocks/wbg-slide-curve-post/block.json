{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-slide-curve-post",
	"version": "0.1.0",
	"title": "Curve Slide - Post",
	"category": "wbg-slides",
	"icon": "grid-view",
	"description": "A 2-column slide that pulls its content and image from an Event or Program.",
	"keywords": [
		"section",
		"columns",
		"2-column",
		"image",
		"slider",
		"event",
		"program"
	],
	"example": {
		"viewportWidth": 1400,
		"attributes": {
			"contentPosition": "content-left"
		}
	},
	"attributes": {
		"contentPosition": {
			"type": "string",
			"enum": ["content-right", "content-left"],
			"default": "content-left"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
