{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-slider-block",
	"version": "0.1.0",
	"title": "Slider - Block",
	"category": "wbg-sliders",
	"icon": "menu",
	"description": "A block slider with arrows and navigation dots.",
	"keywords": ["slider", "carousel", "section"],
	"textdomain": "wbg-blocks",
	"allowedBlocks": [
		"wbg-blocks/wbg-slide-block",
		"wbg-blocks/wbg-slide-simple"
	],
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		},
		"backgroundColor": {
			"type": "string",
			"default": "green"
		},
		"textColor": {
			"type": "string",
			"default": "light-green"
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"autoplay": {
			"type": "string",
			"enum": ["static", "autoplay"],
			"default": "static"
		},
		"button-text": {
			"type": "string",
			"default": ""
		},
		"button-link": {
			"type": "string",
			"default": ""
		},
		"button-opens-in-new-tab": {
			"type": "boolean",
			"default": false
		},
		"button-nofollow": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"layout": false,
		"color": {
			"background": true,
			"text": true,
			"link": false,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"margin": false,
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"example": {
		"viewportWidth": 1400,
		"attributes": {
			"heading": "What's Growing On",
			"autoplay": "static",
			"button-text": "Get Tickets",
			"button-link": "#"
		},
		"innerBlocks": [
			{
				"name": "wbg-blocks/wbg-slide-block",
				"attributes": {
					"date": "August 29",
					"time": "2PM - 3PM",
					"heading": "Gardens Aglimmer",
					"text": "Wander into wonder this holiday season with our favorite holiday tradition, complete with twinkling lights, festive refreshments, and a special visit with Santa.",
					"button-text": "Get Tickets",
					"button-link": "#",
					"overlay": "no-overlay",
					"style": {
						"background": {
							"backgroundImage": {
								"url": "/wp-content/uploads/2026/10/slide-block-example.webp",
								"source": "file",
								"title": "slide-block-example"
							},
							"backgroundSize": "cover",
							"backgroundPosition": "50% 50%",
							"backgroundRepeat": "no-repeat"
						}
					}
				}
			},
			{
				"name": "wbg-blocks/wbg-slide-block",
				"attributes": {
					"date": "August 29",
					"time": "2PM - 3PM",
					"heading": "Kaleidoscope Family Festival",
					"text": "Spend the day with local vendors and nonprofits, dig into hands-on crafts, and cool off with a popsicle from Oh My Lollies. Free with registration.",
					"button-text": "Register Here",
					"button-link": "#",
					"overlay": "no-overlay",
					"style": {
						"background": {
							"backgroundImage": {
								"url": "/wp-content/uploads/2026/11/slide-block-example-2.webp",
								"source": "file",
								"title": "slide-block-example-2"
							},
							"backgroundSize": "cover",
							"backgroundPosition": "50% 50%",
							"backgroundRepeat": "no-repeat"
						}
					}
				}
			}
		]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
