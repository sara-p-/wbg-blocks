{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-slider-curve-full",
	"version": "0.1.0",
	"title": "Curve Slider",
	"category": "wbg-sliders",
	"icon": "slides",
	"description": "A full-width slider of 2-column curve slides, with an optional title circle.",
	"keywords": ["section", "columns", "2-column", "image", "slider", "carousel"],
	"example": {
		"viewportWidth": 1400,
		"attributes": {
			"title": "<em>Adult</em> Education"
		},
		"innerBlocks": [
			{
				"name": "wbg-blocks/wbg-slide-curve-full",
				"attributes": {
					"date": "August 26",
					"time": "6:00pm - 8:00pm",
					"price": "$36",
					"memberPrice": "$28",
					"heading": "<em>Summer Cooking Demo:</em> Tomatoes &amp; Peppers “Beyond BLTs and Salsa”",
					"contentPosition": "content-left",
					"style": {
						"background": {
							"backgroundImage": {
								"url": "/wp-content/uploads/2026/10/2-col-example.webp",
								"source": "file",
								"title": "2-col-example"
							},
							"backgroundSize": "cover",
							"backgroundPosition": "50% 50%",
							"backgroundRepeat": "no-repeat"
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Join Chef Sherry Hurley for a live cooking demonstration, where she’ll share some of her favorite summertime recipes using fresh, local ingredients."
						}
					},
					{
						"name": "core/buttons",
						"innerBlocks": [
							{
								"name": "core/button",
								"attributes": { "text": "Register Here", "url": "#" }
							},
							{
								"name": "core/button",
								"attributes": { "text": "Browse Classes", "url": "#" }
							}
						]
					}
				]
			}
		]
	},
	"allowedBlocks": ["wbg-blocks/wbg-slide-curve-full"],
	"providesContext": {
		"wbg-blocks/sliderTitle": "title"
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		},
		"backgroundColor": {
			"type": "string",
			"default": "cream"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": {
			"background": true,
			"text": false,
			"__experimentalDefaultControls": {
				"background": true
			}
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
