{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbg-blocks/wbg-slider-testimonial",
	"version": "0.1.0",
	"title": "Testimonial Slider",
	"category": "wbg-sliders",
	"icon": "format-quote",
	"description": "A full-width slider of Testimonials, with a static heading, text and buttons that the slides wrap around.",
	"keywords": ["slider", "carousel", "testimonial", "quote", "review", "query"],
	"example": {
		"viewportWidth": 1400,
		"attributes": {
			"heading": "<em>Voices of</em> The Gardens",
			"text": "We asked our members to share their favorite stories of the Gardens. Here’s what they shared with us.",
			"button1Text": "Make a Donation",
			"button1Url": "#",
			"perPage": 3
		},
		"innerBlocks": [
			{
				"name": "wbg-blocks/wbg-slide-testimonial"
			}
		]
	},
	"allowedBlocks": ["wbg-blocks/wbg-slide-testimonial"],
	"providesContext": {
		"wbg-blocks/sliderHeading": "heading",
		"wbg-blocks/sliderSubheading": "subheading"
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"subheading": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"button1Text": {
			"type": "string",
			"default": ""
		},
		"button1Url": {
			"type": "string",
			"default": ""
		},
		"button1OpensInNewTab": {
			"type": "boolean",
			"default": false
		},
		"button1Nofollow": {
			"type": "boolean",
			"default": false
		},
		"button2Text": {
			"type": "string",
			"default": ""
		},
		"button2Url": {
			"type": "string",
			"default": ""
		},
		"button2OpensInNewTab": {
			"type": "boolean",
			"default": false
		},
		"button2Nofollow": {
			"type": "boolean",
			"default": false
		},
		"taxQuery": {
			"type": "object",
			"default": {}
		},
		"perPage": {
			"type": "number",
			"default": 6
		},
		"orderBy": {
			"type": "string",
			"enum": ["date", "title", "modified", "menu_order", "rand"],
			"default": "date"
		},
		"order": {
			"type": "string",
			"enum": ["asc", "desc"],
			"default": "desc"
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"spacing": {
			"padding": ["top", "bottom"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "wbg-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
